# Supabase Configuration
# Recupera questi parametri dalla dashboard di Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (opzionale, solo per operazioni amministrative server-side)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Base URL (aggiorna in produzione su Vercel, es. https://tuo-dominio.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
